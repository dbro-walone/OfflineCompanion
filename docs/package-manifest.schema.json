{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offline-companion.local/schemas/package-manifest-v1.json",
  "title": "Offline Companion package manifest v1",
  "oneOf": [
    { "$ref": "#/$defs/character" },
    { "$ref": "#/$defs/actionPack" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["schemaVersion", "packageType", "id", "name", "version", "engineVersion"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "packageType": { "enum": ["character", "action"] },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "engineVersion": { "type": "string", "minLength": 1 }
      }
    },
    "character": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["author", "license", "preview", "defaultAction", "frame", "actions"],
          "properties": {
            "packageType": { "const": "character" },
            "author": { "type": "string", "minLength": 1 },
            "license": { "type": "string", "minLength": 1 },
            "preview": { "$ref": "#/$defs/relativePath" },
            "defaultAction": { "type": "string", "minLength": 1 },
            "defaultScale": { "type": "number", "minimum": 0.75, "maximum": 1.4 },
            "scaleRange": {
              "type": "object",
              "required": ["min", "max"],
              "properties": {
                "min": { "type": "number", "minimum": 0.75, "maximum": 1.4 },
                "max": { "type": "number", "minimum": 0.75, "maximum": 1.4 }
              },
              "additionalProperties": false
            },
            "frame": {
              "type": "object",
              "required": ["width", "height"],
              "properties": {
                "width": { "type": "integer", "minimum": 1 },
                "height": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            },
            "actions": {
              "type": "object",
              "required": ["idle"],
              "additionalProperties": { "$ref": "#/$defs/relativePath" }
            }
          }
        }
      ]
    },
    "actionPack": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["compatibleCharacters", "actions"],
          "properties": {
            "packageType": { "const": "action" },
            "priority": { "type": "integer" },
            "compatibleCharacters": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "version"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "version": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            },
            "actions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "trigger", "animation"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "trigger": { "type": "string", "minLength": 1 },
                  "weight": { "type": "integer", "minimum": 1 },
                  "cooldownSeconds": { "type": "integer", "minimum": 0 },
                  "animation": { "$ref": "#/$defs/relativePath" }
                },
                "additionalProperties": false
              }
            }
          }
        }
      ]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^[A-Za-z]:" },
          { "pattern": "^[/\\\\]" },
          { "pattern": "(^|[/\\\\])\\.\\.([/\\\\]|$)" }
        ]
      }
    }
  }
}
