<Window x:Class="Companion.App.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animation="clr-namespace:Companion.Presentation.Animation;assembly=Companion.Presentation"
        Title="鸦影"
        Width="250" Height="330"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AutomationProperties.Name="桌面伙伴鸦影"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseLeftButtonUp="OnMouseLeftButtonUp"
        MouseMove="OnMouseMove"
        MouseEnter="OnMouseEnter"
        MouseLeave="OnMouseLeave"
        MouseDoubleClick="OnMouseDoubleClick"
        Closing="OnClosing">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="待办事项" Click="OpenTodos" />
            <MenuItem Header="定时提醒" Click="OpenReminder" />
            <MenuItem Header="番茄钟" Click="OpenTimer" />
            <Separator />
            <MenuItem Header="切换角色与动作管理" Click="OpenPackages" />
            <MenuItem Header="设置" Click="OpenSettings" />
            <Separator />
            <MenuItem Header="退出" Click="ExitApplication" />
        </ContextMenu>
    </Window.ContextMenu>
    <Grid x:Name="PetVisual">
        <animation:SpriteAnimationView x:Name="Sprite"
                                       Frames="0,1,2,3"
                                       Fps="2"
                                       ToolTip="左键互动或拖动，双击切换写轮眼，右键打开菜单" />
        <!-- Shield overlay shown on mouse hover -->
        <TextBlock x:Name="ShieldOverlay"
                   Text="🛡️"
                   FontSize="48"
                   Opacity="0"
                   IsHitTestVisible="False"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
                <ScaleTransform x:Name="ShieldScale" ScaleX="0.5" ScaleY="0.5" />
            </TextBlock.RenderTransform>
        </TextBlock>
        <Border x:Name="Fallback"
                Visibility="Collapsed"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="18">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="鸦影" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="26"
                           FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="角色资源暂不可用" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,8,0,0" TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
