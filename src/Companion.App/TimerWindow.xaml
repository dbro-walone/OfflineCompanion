<Window x:Class="Companion.App.TimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="番茄钟" Width="420" Height="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        AutomationProperties.Name="番茄钟窗口">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="专注计时" FontSize="26" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="保持节奏，专注当下"
                       Style="{StaticResource SecondaryText}"
                       HorizontalAlignment="Center" Margin="0,3,0,0" />
            <TextBlock x:Name="ActiveTodoText" Visibility="Collapsed"
                       Foreground="{DynamicResource AccentHoverBrush}"
                       HorizontalAlignment="Center" Margin="0,8,0,0"
                       TextTrimming="CharacterEllipsis" MaxWidth="340"
                       AutomationProperties.Name="当前专注待办" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="TimeText" Text="25:00"
                           FontSize="58" FontWeight="Light"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           AutomationProperties.Name="剩余时间" />
                <StackPanel Grid.Row="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,10,0,-4">
                    <Button Content="开始" Click="StartTimer"
                            Style="{StaticResource AccentButton}"
                            AutomationProperties.Name="开始番茄钟" />
                    <Button Content="暂停/继续" Click="TogglePause"
                            AutomationProperties.Name="暂停或继续番茄钟" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
