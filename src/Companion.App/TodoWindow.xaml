<Window x:Class="Companion.App.TodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办事项" Width="500" Height="600"
        MinWidth="420" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="待办事项窗口">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="待办事项" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="数据仅保存在这台电脑上"
                       Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,12">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="添加"
                            Style="{StaticResource AccentButton}"
                            Margin="10,0,0,0"
                            Command="{Binding AddCommand}"
                            AutomationProperties.Name="添加待办" />
                    <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="38"
                             AutomationProperties.Name="待办标题"
                             KeyDown="OnTitleKeyDown" />
                </DockPanel>
                <CheckBox Content="显示已完成" IsChecked="{Binding IncludeCompleted}"
                          Margin="0,12,0,0" />
            </StackPanel>
        </Border>
        <ListBox Grid.Row="2" ItemsSource="{Binding Items}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,2">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Left"
                                      IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                      Tag="{Binding}"
                                      Checked="OnTodoToggled"
                                      Unchecked="OnTodoToggled"
                                      AutomationProperties.Name="切换待办完成状态" />
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="{Binding Title}" FontSize="15"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DueAt, StringFormat='到期：{0:g}'}"
                                           Style="{StaticResource SecondaryText}"
                                           FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
