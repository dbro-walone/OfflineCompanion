<Window x:Class="Companion.App.TodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办事项" Width="480" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F6FA"
        AutomationProperties.Name="待办事项窗口">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="待办事项" FontSize="26" FontWeight="SemiBold"
                       Foreground="#252A3A" />
            <TextBlock Text="数据仅保存在这台电脑上" Foreground="#667085"
                       Margin="0,2,0,12" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="添加"
                        Command="{Binding AddCommand}"
                        AutomationProperties.Name="添加待办" />
                <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="36" Padding="8"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="待办标题"
                         KeyDown="OnTitleKeyDown" />
            </DockPanel>
            <CheckBox Content="显示已完成" IsChecked="{Binding IncludeCompleted}"
                      Margin="4,10,0,10" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Items}" BorderThickness="0"
                 Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="10" Padding="12"
                            Margin="0,4">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Left"
                                      IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                      Tag="{Binding}"
                                      Checked="OnTodoToggled"
                                      Unchecked="OnTodoToggled"
                                      AutomationProperties.Name="切换待办完成状态" />
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="{Binding Title}" FontSize="15"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DueAt, StringFormat='到期：{0:g}'}"
                                           Foreground="#667085" FontSize="12" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
