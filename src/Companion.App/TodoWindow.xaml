<Window x:Class="Companion.App.TodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办事项" Width="660" Height="720"
        MinWidth="560" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="待办事项窗口">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="待办事项" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="为任务安排番茄钟，数据仅保存在这台电脑上"
                       Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,12">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="添加"
                            Style="{StaticResource AccentButton}"
                            Margin="10,0,0,0"
                            Command="{Binding AddCommand}"
                            AutomationProperties.Name="添加待办" />
                    <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="38"
                             AutomationProperties.Name="待办标题"
                             KeyDown="OnTitleKeyDown" />
                </DockPanel>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="截止日期（可选）" Style="{StaticResource SecondaryText}"
                                   FontSize="12" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding NewDueDate}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="时间" Style="{StaticResource SecondaryText}"
                                   FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewDueTime, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="HH:mm，例如 18:30"
                                 AutomationProperties.Name="截止时间" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="预计番茄数" Style="{StaticResource SecondaryText}"
                                   FontSize="12" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding PomodoroOptions}"
                                  SelectedItem="{Binding NewEstimatedPomodoros}"
                                  AutomationProperties.Name="预计番茄数" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding ValidationMessage}"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontSize="12" Margin="0,7,0,0" />
                <DockPanel Margin="0,12,0,0">
                    <Button DockPanel.Dock="Right" Content="清除已完成"
                            Click="OnClearCompleted"
                            AutomationProperties.Name="清除已完成待办" />
                    <CheckBox Content="显示已完成" IsChecked="{Binding IncludeCompleted}" />
                </DockPanel>
            </StackPanel>
        </Border>

        <ListBox Grid.Row="2" ItemsSource="{Binding Items}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,2">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Setter Property="Padding" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="Opacity" Value="0.62" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="OverdueIndicator" Background="Transparent"
                                    CornerRadius="9,0,0,9" />
                            <CheckBox Grid.Column="1" Margin="14,0,2,0"
                                      IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                      Tag="{Binding}"
                                      Click="OnTodoToggled"
                                      AutomationProperties.Name="切换待办完成状态" />
                            <StackPanel Grid.Column="2" Margin="10,12">
                                <TextBlock Text="{Binding Title}" FontSize="15"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding EffectiveDueAt, StringFormat='截止：{0:g}'}"
                                           Style="{StaticResource SecondaryText}"
                                           FontSize="12" Margin="0,4,0,0" />
                                <TextBlock Style="{StaticResource SecondaryText}"
                                           FontSize="12" Margin="0,3,0,0">
                                    <Run Text="番茄进度：" />
                                    <Run Text="{Binding CompletedPomodoros}" />
                                    <Run Text=" / " />
                                    <Run Text="{Binding EstimatedPomodoros}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="3" Content="开始专注"
                                    Tag="{Binding}" Click="OnStartFocus"
                                    IsEnabled="{Binding CanFocus}"
                                    Style="{StaticResource AccentButton}"
                                    Margin="8,0,12,0"
                                    AutomationProperties.Name="为此待办开始专注" />
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                            <Setter TargetName="OverdueIndicator"
                                    Property="Background"
                                    Value="{DynamicResource ErrorBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="上一页"
                    IsEnabled="{Binding CanGoPrevious}" Click="OnPreviousPage" />
            <Button DockPanel.Dock="Right" Content="下一页"
                    IsEnabled="{Binding CanGoNext}" Click="OnNextPage" />
            <TextBlock Text="{Binding PageStatus}" Style="{StaticResource SecondaryText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
