<Window x:Class="Companion.App.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建定时提醒" Width="400" Height="310"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F6FA"
        AutomationProperties.Name="新建定时提醒窗口">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="新建定时提醒" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="标题" Margin="0,18,0,4" />
        <TextBox x:Name="TitleBox" Grid.Row="2" MinHeight="36" Padding="8"
                 AutomationProperties.Name="提醒标题" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
            <DatePicker x:Name="DatePicker" Width="170"
                        AutomationProperties.Name="提醒日期" />
            <TextBox x:Name="TimeBox" Width="100" Margin="10,0,0,0"
                     Text="09:00" Padding="8"
                     AutomationProperties.Name="提醒时间" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" Grid.Row="4" Foreground="#B42318"
                   Margin="0,12,0,0" TextWrapping="Wrap" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Click="Cancel" IsCancel="True" />
            <Button Content="保存" Click="Save" IsDefault="True"
                    AutomationProperties.Name="保存提醒" />
        </StackPanel>
    </Grid>
</Window>
