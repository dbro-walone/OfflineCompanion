<Window x:Class="Companion.App.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建定时提醒" Width="430" Height="365"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        AutomationProperties.Name="新建定时提醒窗口">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="新建定时提醒" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="为重要事项设置一个本地提醒"
                       Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="标题" Margin="0,0,0,6" />
                <TextBox x:Name="TitleBox" Grid.Row="1" MinHeight="38"
                         AutomationProperties.Name="提醒标题" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
                    <DatePicker x:Name="DatePicker" Width="190"
                                AutomationProperties.Name="提醒日期" />
                    <TextBox x:Name="TimeBox" Width="100" Margin="10,0,0,0"
                             Text="09:00"
                             AutomationProperties.Name="提醒时间" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" Grid.Row="3"
                           Foreground="{StaticResource ErrorBrush}"
                           Margin="0,10,0,0" TextWrapping="Wrap" />
                <StackPanel Grid.Row="4" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,12,-4,-4">
                    <Button Content="取消" Click="Cancel" IsCancel="True" />
                    <Button Content="保存" Click="Save" IsDefault="True"
                            Style="{StaticResource AccentButton}"
                            AutomationProperties.Name="保存提醒" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
