<Window x:Class="Companion.App.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="320" Height="160"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        Topmost="True"
        AutomationProperties.Name="提醒气泡">
    <Border Background="{StaticResource PanelBackground}" CornerRadius="12"
            Padding="18" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="提醒" Foreground="{StaticResource AccentHoverBrush}"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="MessageText" FontSize="15"
                       Margin="0,8,0,12" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="延后 10 分钟" Click="Snooze" />
                <Button Content="知道了" Click="Dismiss" IsDefault="True"
                        Style="{StaticResource AccentButton}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
