<Window x:Class="Companion.App.PackageManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="角色与动作包" Width="560" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F6FA"
        AutomationProperties.Name="角色与动作包管理窗口">
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="角色与动作包" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="扩展包只允许声明式 JSON 与本地媒体资源"
                       Foreground="#667085" Margin="0,3,0,12" />
            <Button Content="导入 ZIP 扩展包" HorizontalAlignment="Left"
                    Click="ImportPackage" AutomationProperties.Name="导入扩展包" />
            <TextBlock x:Name="StatusText" Margin="4,8,4,10"
                       Foreground="#475467" TextWrapping="Wrap" />
        </StackPanel>
        <ListBox x:Name="PackageList" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="10" Padding="12" Margin="0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Id}" Foreground="#667085" FontSize="12" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Version}"
                                       VerticalAlignment="Center" Foreground="#667085" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
