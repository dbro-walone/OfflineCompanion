<Window x:Class="Companion.App.PackageManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="角色与动作包" Width="590" Height="530"
        MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="角色与动作包管理窗口">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="角色与动作包" FontSize="27" FontWeight="SemiBold" />
            <TextBlock Text="扩展包只允许声明式 JSON 与本地媒体资源"
                       Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="导入 ZIP 扩展包"
                        Style="{StaticResource AccentButton}" Margin="-4,-4,12,-4"
                        Click="ImportPackage" AutomationProperties.Name="导入扩展包" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
        <ListBox x:Name="PackageList" Grid.Row="2">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="15"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Id}"
                                           Style="{StaticResource SecondaryText}"
                                           FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#336B7DFF"
                                    BorderBrush="#666B7DFF" BorderThickness="1"
                                    CornerRadius="8" Padding="9,4"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Version}"
                                           Foreground="{StaticResource AccentHoverBrush}"
                                           FontSize="12" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
