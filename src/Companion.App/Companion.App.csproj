<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>OfflineCompanion</AssemblyName>
    <RootNamespace>Companion.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Companion.Application\Companion.Application.csproj" />
    <ProjectReference Include="..\Companion.Domain\Companion.Domain.csproj" />
    <ProjectReference Include="..\Companion.Infrastructure\Companion.Infrastructure.csproj" />
    <ProjectReference Include="..\Companion.Packages\Companion.Packages.csproj" />
    <ProjectReference Include="..\Companion.Presentation\Companion.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\packages\**\*">
      <LogicalName>OfflineCompanion.packages.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
