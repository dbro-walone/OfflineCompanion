<Window x:Class="Companion.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="480" Height="540"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="设置窗口">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="自定义鸦影的外观与行为"
                       Style="{StaticResource SecondaryText}" Margin="0,3,0,18" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="桌宠" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="缩放（75%～140%）"
                               Style="{StaticResource SecondaryText}" />
                    <Slider x:Name="ScaleSlider" Minimum="0.75" Maximum="1.4"
                            TickFrequency="0.05" IsSnapToTickEnabled="True"
                            ValueChanged="OnScaleChanged" />
                    <CheckBox x:Name="TopmostCheck" Content="保持置顶" Margin="0,10,0,3"
                              Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                    <CheckBox x:Name="IdleCheck" Content="启用主动空闲动作"
                              Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                    <CheckBox x:Name="ReduceMotionCheck" Content="减少动态效果"
                              Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="隐私与数据" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="应用完全离线运行，不创建 HTTP 客户端，不收集遥测。"
                               TextWrapping="Wrap" Style="{StaticResource SecondaryText}" />
                    <TextBlock Text="数据位置" FontWeight="SemiBold" Margin="0,15,0,5" />
                    <TextBlock x:Name="DataPathText" TextWrapping="Wrap"
                               Style="{StaticResource SecondaryText}" />
                </StackPanel>
            </Border>
            <Button Content="关闭" HorizontalAlignment="Right" Margin="0,18,0,0"
                    Style="{StaticResource AccentButton}" Click="CloseWindow" />
        </StackPanel>
    </ScrollViewer>
</Window>
