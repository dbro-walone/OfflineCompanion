<Window x:Class="Companion.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="460" Height="440"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F6FA"
        AutomationProperties.Name="设置窗口">
    <ScrollViewer>
        <StackPanel Margin="24">
            <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="桌宠" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,6" />
            <TextBlock Text="缩放（75%～140%）" />
            <Slider x:Name="ScaleSlider" Minimum="0.75" Maximum="1.4"
                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                    ValueChanged="OnScaleChanged" />
            <CheckBox x:Name="TopmostCheck" Content="保持置顶" Margin="0,10,0,0"
                      Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
            <CheckBox x:Name="IdleCheck" Content="启用主动空闲动作"
                      Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
            <CheckBox x:Name="ReduceMotionCheck" Content="减少动态效果"
                      Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
            <TextBlock Text="隐私" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,6" />
            <TextBlock Text="应用完全离线运行，不创建 HTTP 客户端，不收集遥测。"
                       TextWrapping="Wrap" Foreground="#475467" />
            <TextBlock Text="数据位置" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,6" />
            <TextBlock x:Name="DataPathText" TextWrapping="Wrap" Foreground="#475467" />
            <Button Content="关闭" HorizontalAlignment="Right" Margin="0,22,0,0"
                    Click="CloseWindow" />
        </StackPanel>
    </ScrollViewer>
</Window>
